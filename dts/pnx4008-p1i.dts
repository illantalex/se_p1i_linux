// SPDX-License-Identifier: GPL-2.0
/*
 * Sony Ericsson P1i -- NXP (Philips) Nexperia PNX4008, ARM926EJ-S r0p4 @ 208 MHz,
 * 32 KB I + 32 KB D cache, 128 MB SDRAM at 0x80000000.
 *
 * Bring-up DTS: just enough for the decompressor and early boot to talk on UART5
 * (SP2663, 115200 8N1). The handover payload has already set UART5's clock and
 * divisor, so the console works without any clock driver.
 *
 * Built on the LPC32xx layout (the PNX4008's successor, same peripheral map) but NOT on
 * lpc32xx.dtsi: the root compatible deliberately avoids "nxp,lpc32x0", so the generic
 * DT machine is used instead of mach-lpc32xx, whose init code reprograms UART clocks.
 *
 * Verified on the device (regprobe, then uart5probe): UART3-6 bases, MIC/SIC1/SIC2 bases and register
 * layout, clock block at 0x40004000, watchdog at 0x4003c000, UART5 @ 13 MHz / 16 / 7.
 * Verified by the payload stub's register dump: MSTIM on MIC line 27, level high; MIC
 * polarity/type Symbian left (POL 3b3b0ce0, TYPE 0) agrees with every trigger below.
 * NOT yet verified: the other interrupt numbers (taken from LPC32xx), RAM hole position.
 *
 * Build inside a kernel tree: copy to arch/arm/boot/dts/ (arch/arm/boot/dts/nxp/lpc/ on
 * >= 6.5) and run  make ARCH=arm CROSS_COMPILE=arm-none-eabi- pnx4008-p1i.dtb
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Sony Ericsson P1i";
	compatible = "sonyericsson,p1i", "nxp,pnx4008";
	interrupt-parent = <&mic>;
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		serial0 = &uart6;	/* -> ttyS0: console + shell (IrDA module pads, TX and RX) */
		serial1 = &uart5;	/* -> ttyS1: no longer wired (kept for a future modem) */
	};

	chosen {
		/*
		 * No baud on earlycon: with one it reprograms the divisor assuming a 1.8432 MHz
		 * clock (divisor 1 here, ~812 kbaud). Without one it keeps the payload's setting.
		 */
		/*
		 * Console on UART6 only: the 8250 driver has a single console, and with two
		 * console= ttyS entries the first port to probe (UART5) takes it.
		 */
		bootargs = "earlycon=uart8250,mmio32,0x40098000 console=tty0 console=ttyS0,115200n8 ignore_loglevel";
		stdout-path = "serial0:115200n8";
	};

	/*
	 * HAL reports 0x7b00000 (123 MB) of 128 MB usable; the missing 5 MB is presumably
	 * framebuffer / modem memory. Assumed at the top (0x87b00000-0x87ffffff) because
	 * Symbian's own page tables live low (TTBR 0x80504000). Confirm against the probe's
	 * RamBootData dump before trusting it; a wrong guess here corrupts memory silently.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x07b00000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Symbian's framebuffer, still scanned out by the DUM after handover. */
		framebuffer_mem: framebuffer@81000000 {
			reg = <0x81000000 0x50000>;
			no-map;
		};

		/* Audio DSP shared buffer (dsptool experiments; the DSP reads it by physical address). */
		dsp_shared: dsp-shared@81100000 {
			reg = <0x81100000 0x10000>;
			no-map;
		};
	};

	/*
	 * Display: Symbian leaves the DUM (Display Update Module, 0x400B8000 channels,
	 * 0x400BC000 main) and the Sony panel configured. DUM_DECODE = 0x01000000, i.e.
	 * the framebuffer at 0x81000000; 32 channels of 0x2800 bytes each cover 320 lines of
	 * 1024 bytes = 240 pixels x 4 bytes, padded (DUM PAD_1024, RGB888 in 32 bits). The DUM
	 * refreshes the panel by itself on writes (channel CONF 0xa026: dirty detection +
	 * sync), so a plain simple-framebuffer works. Verified on the device: orientation,
	 * stride and x8r8g8b8 colours (solid R/G/B/W fills) are right.
	 */
	framebuffer@81000000 {
		compatible = "simple-framebuffer";
		reg = <0x81000000 0x50000>;
		width = <240>;
		height = <320>;
		stride = <1024>;
		format = "x8r8g8b8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			compatible = "arm,arm926ej-s";
			device_type = "cpu";
			reg = <0x0>;
		};
	};

	clocks {
		/* PERIPH_CLK: 13 MHz, confirmed by UART5 at divisor 7 -> 116071 baud. */
		periph_clk: periph-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <13000000>;
		};

		/*
		 * HCLK (AHB), clocks the I2C blocks. Verified from the stub's dump: HCLKPLL_CTRL
		 * 0x0001601f (direct mode, M = 16: 13 MHz * 16 = 208 MHz), HCLKDIV_CTRL 0x3d
		 * (HCLK = PLL / 2, PERIPH_CLK = PLL / 16 = 13 MHz).
		 */
		/* HCLK PLL output (208 MHz, see below); the Memory Stick clock divides it down. */
		hclk_pll: hclk-pll {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <208000000>;
		};

		hclk: hclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <104000000>;
		};

		xtal_32k: xtal-32k {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
		};
	};

	/*
	 * Display and keypad backlights (sheet BCT1DE). BACKLIGHT_LEVEL (PWM_OUT2) dims both;
	 * with the PWM disabled its pin is low and both are dark. GPO_09 NUM_BACKLIGHT_EN and
	 * GPO_10 QWERTY_BACKLIGHT_EN, verified on the device:
	 *   9/10 = 0/0 all off, 1/0 or 0/1 display + keypad, 1/1 display only.
	 * So GPO_10 is held high (hog in the gpio node) and GPO_09 (active low) is the keypad
	 * LED; display on/off is the PWM alone, which darkens everything when disabled,
	 * whatever GPO_09 is. GPO_10 is deliberately not the backlight's enable-gpios:
	 * pwm-backlight toggles it while the PWM still runs, and the transient 1/0 state
	 * flashes the keypad. Keypad brightness follows the display's.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm2 0 7812500 0>;	/* 32768 Hz / 256 = 128 Hz, as Symbian */
		/* Below ~15% duty the boost converter gives no visible light. */
		brightness-levels = <0 40 64 96 128 160 192 224 255>;
		default-brightness-level = <6>;	/* 75%, near Symbian's 73% */
	};

	leds {
		compatible = "gpio-leds";

		led-keypad {
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&gpio 5 9 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		/* AHB peripherals (Memory Stick host) and APB peripherals */
		ranges = <0x20000000 0x20000000 0x00100000>,
			 <0x40000000 0x40000000 0x10000000>;

		/* Main interrupt controller; register layout ER RSR SR APR ATR ITR (probe). */
		mic: interrupt-controller@40008000 {
			compatible = "nxp,lpc3220-mic";
			reg = <0x40008000 0x4000>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		sic1: interrupt-controller@4000c000 {
			compatible = "nxp,lpc3220-sic";
			reg = <0x4000c000 0x4000>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&mic>;
			interrupts = <0 IRQ_TYPE_LEVEL_LOW>, <30 IRQ_TYPE_LEVEL_LOW>;
		};

		sic2: interrupt-controller@40010000 {
			compatible = "nxp,lpc3220-sic";
			reg = <0x40010000 0x4000>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&mic>;
			interrupts = <1 IRQ_TYPE_LEVEL_LOW>, <31 IRQ_TYPE_LEVEL_LOW>;
		};

		/*
		 * Standard 16550-style UARTs, 32-bit registers on a 4-byte stride.
		 * MIC lines are NOT the LPC32xx ones: the stub's THRE test put UART5 on line 9
		 * and UART6 on line 10, both level high (verified). UART3/4 at 7/8 assume the
		 * same shift and are unverified.
		 */
		uart3: serial@40080000 {
			compatible = "nxp,lpc3220-uart", "ns16550a";
			reg = <0x40080000 0x1000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			interrupts = <7 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&periph_clk>;
			status = "disabled";	/* in use by Symbian's side of the board */
		};

		uart4: serial@40088000 {
			compatible = "nxp,lpc3220-uart", "ns16550a";
			reg = <0x40088000 0x1000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			interrupts = <8 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&periph_clk>;
			status = "disabled";
		};

		uart5: serial@40090000 {
			compatible = "nxp,lpc3220-uart", "ns16550a";
			reg = <0x40090000 0x1000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			interrupts = <9 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&periph_clk>;
			status = "okay";
		};

		/*
		 * UART6 is the IrDA UART; the payload stub sets UART_CTRL bit 5 (IrDA modulator
		 * bypass) and its clocks, so it works as a plain 16550. Wired via the removed
		 * IrDA module H2660: pin 2 RXD = U6_IRRX, pin 3 TxD = U6_IRTX; RX pull-up R2677.
		 * Symbian left UART_CTRL at 0x20e (IrDA mode, pulse shaping, TX mirror invert,
		 * half duplex); the stub clears those and sets the bypass.
		 */
		uart6: serial@40098000 {
			compatible = "nxp,lpc3220-uart", "ns16550a";
			reg = <0x40098000 0x1000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			interrupts = <10 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&periph_clk>;
			status = "okay";
		};

		/*
		 * I2C1/I2C2 (Philips IP3204, drivers/i2c/busses/i2c-pnx.c). Symbian leaves their
		 * clocks off; the payload stub turns them on (I2CCLK_CTRL bits 0-1). Interrupts
		 * are the LPC32xx ones, verified: the stub's TX-FIFO-not-full test raised SIC1
		 * line 19 for I2C1 (active low), and I2C2 works on line 18.
		 * I2C1 is the camera bus (MV9319 ISP, camera connector X2741); its pull-ups go to
		 * VORG_CAM1.8, which is off unless CAM_POW (GPO_21) is high, so the bus reads low.
		 * I2C2 has the STCF03 flash LED driver (0x30) and the STMPE801 GPIO expander
		 * (0x41); the SI4703 FM tuner is on it too but only answers once powered up.
		 */
		i2c1: i2c@400a0000 {
			compatible = "nxp,pnx-i2c";
			reg = <0x400a0000 0x100>;
			interrupt-parent = <&sic1>;
			interrupts = <19 IRQ_TYPE_LEVEL_LOW>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&hclk>;
			clock-frequency = <100000>;
		};

		i2c2: i2c@400a8000 {
			compatible = "nxp,pnx-i2c";
			reg = <0x400a8000 0x100>;
			interrupt-parent = <&sic1>;
			interrupts = <18 IRQ_TYPE_LEVEL_LOW>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&hclk>;
			clock-frequency = <100000>;

			/*
			 * STCF03 camera flash LED driver (power sheet), torch mode only: its TRIG
			 * input comes from the camera ISP. Verified by hand with i2cset: CMD 0xa0
			 * (PWR_ON | TCH_ON) lights the torch; the torch level is one nibble of
			 * DIM (the driver writes both).
			 */
			led-controller@30 {
				compatible = "st,stcf03";
				reg = <0x30>;
				color = <LED_COLOR_ID_WHITE>;
				function = LED_FUNCTION_TORCH;
			};

			/*
			 * STMPE801 "Expander 1" (N5509, audio sheet): ADDRESS tied low, RESET =
			 * USB_RST#, INT not connected, so it runs in the driver's no-irq mode.
			 */
			gpio-expander@41 {
				compatible = "st,stmpe801";
				reg = <0x41>;

				stmpe_gpio: gpio {
					compatible = "st,stmpe-gpio";
					gpio-controller;
					#gpio-cells = <2>;
					/* GPIO_0..2 are tied together and pulled down: unused. */
					gpio-line-names = "", "", "", "WLAN_POW", "FM_RST#",
							  "KNATTE3_CTRL1_INT", "KNATTE3_CTRL2_INT",
							  "IR_SHDN#";
				};
			};
		};

		/*
		 * GPIO block, LPC32xx layout (drivers/gpio/gpio-lpc32xx.c). Cells: bank, pin,
		 * flags; banks 0-2 = P0-P2 (LPC32xx only, unverified here), 3 = GPIO_P3,
		 * 4 = GPI_P3 inputs, 5 = GPO_P3 outputs. Verified: GPO_n is bit n of
		 * P3_OUTP_SET/CLR/STATE (GPO_21 = CAM_POW, GPO_11 = CAM_RST#).
		 */
		/*
		 * Memory Stick host (Sony MS core, as in tifm_ms), from Symbian's pbusms.dll and
		 * vpbusms.dll: registers at virtual 0x63680000 = 0x20080000, interrupt 12. The
		 * card clock is set in MS_CTRL (0x40004080) as PLL / ceil(PLL / 20 MHz) with bits
		 * 5-7 set. Card power is GPO_06 (MSMICRO_POW), card detect GPI_00 (low = card in).
		 */
		memstick@20080000 {
			compatible = "nxp,pnx4008-ms";
			reg = <0x20080000 0x1000>, <0x40004080 0x4>;
			interrupts = <12 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&hclk_pll>;
			power-gpios = <&gpio 5 6 GPIO_ACTIVE_HIGH>;
			cd-gpios = <&gpio 4 0 GPIO_ACTIVE_LOW>;
		};

		gpio: gpio@40028000 {
			compatible = "nxp,lpc3220-gpio";
			reg = <0x40028000 0x1000>;
			gpio-controller;
			#gpio-cells = <3>;

			/* Backlight enable, see the backlight node. */
			qwerty-backlight-en-hog {
				gpio-hog;
				gpios = <5 10 GPIO_ACTIVE_HIGH>;
				output-high;
				line-name = "QWERTY_BACKLIGHT_EN";
			};
		};

		/*
		 * Key scanner, LPC32xx layout (drivers/input/keyboard/lpc32xx-keys.c). Wiring
		 * (sheet BCT1DA p6): KEY_COL[0..5] / KEY_ROW[0..5] on the scanner pins, KEY_ROW[6]
		 * on GPIO_02 and KEY_COL[6] on GPI_08 -- the scanner still handles them: with a
		 * 7x7 matrix, Y (KEY_ROW[6] x KEY_COL[5]) reads back as data word 6, bit 5. The
		 * jog dial rotation is on GPIO_00 (JOG_INT) / GPIO_01 (JOG_DIR), not here.
		 * Interrupt SIC1 22, verified on the device.
		 * Keymap from evdump on the device (scancode = row * 8 + col), German QWERTZ labels.
		 */
		keypad@40050000 {
			compatible = "nxp,lpc3220-key";
			reg = <0x40050000 0x1000>;
			interrupt-parent = <&sic1>;
			interrupts = <22 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal_32k>;
			keypad,num-rows = <7>;
			keypad,num-columns = <7>;
			nxp,debounce-delay-ms = <3>;
			nxp,scan-delay-ms = <34>;
			linux,keymap = <
				MATRIX_KEY(0, 0, KEY_EMAIL)	/* "@" key */
				MATRIX_KEY(0, 2, KEY_O)
				MATRIX_KEY(0, 3, KEY_P)
				MATRIX_KEY(0, 4, KEY_L)
				MATRIX_KEY(0, 5, KEY_BACKSPACE)	/* 2nd row, 10th key */
				MATRIX_KEY(0, 6, KEY_ENTER)	/* KEY_ROW[6] x KEY_COL[0] */
				MATRIX_KEY(1, 0, KEY_CAMERA)	/* camera full press (with focus held) */
				MATRIX_KEY(1, 2, KEY_U)
				MATRIX_KEY(1, 3, KEY_I)
				MATRIX_KEY(1, 4, KEY_J)
				MATRIX_KEY(1, 5, KEY_K)
				MATRIX_KEY(2, 0, KEY_CAMERA_FOCUS)	/* camera half press */
				MATRIX_KEY(2, 2, KEY_Z)
				MATRIX_KEY(2, 3, KEY_H)
				MATRIX_KEY(2, 4, KEY_G)
				MATRIX_KEY(3, 1, KEY_ENTER)	/* jog dial press */
				MATRIX_KEY(3, 2, KEY_R)
				MATRIX_KEY(3, 3, KEY_T)
				MATRIX_KEY(3, 4, KEY_F)
				MATRIX_KEY(4, 2, KEY_E)
				MATRIX_KEY(4, 3, KEY_D)
				MATRIX_KEY(4, 4, KEY_S)
				MATRIX_KEY(5, 0, KEY_BACK)	/* Back */
				MATRIX_KEY(5, 2, KEY_Q)
				MATRIX_KEY(5, 3, KEY_W)
				MATRIX_KEY(5, 4, KEY_A)
				MATRIX_KEY(1, 6, KEY_DOT)	/* KEY_ROW[6] x KEY_COL[1] */
				MATRIX_KEY(2, 6, KEY_N)	/* KEY_ROW[6] x KEY_COL[2] */
				MATRIX_KEY(3, 6, KEY_B)	/* KEY_ROW[6] x KEY_COL[3] */
				MATRIX_KEY(4, 6, KEY_X)	/* KEY_ROW[6] x KEY_COL[4] */
				MATRIX_KEY(5, 6, KEY_Y)	/* KEY_ROW[6] x KEY_COL[5] */
				MATRIX_KEY(5, 5, KEY_COMMA)
				MATRIX_KEY(4, 5, KEY_C)
				MATRIX_KEY(3, 5, KEY_V)
				MATRIX_KEY(2, 5, KEY_M)
				/* Bottom row: KEY_COL[6] x KEY_ROW[2..6] */
				MATRIX_KEY(6, 2, KEY_LEFTSHIFT)
				MATRIX_KEY(6, 3, KEY_LEFT)	/* also "*" */
				MATRIX_KEY(6, 4, KEY_SPACE)	/* also "0+" */
				MATRIX_KEY(6, 5, KEY_RIGHT)	/* also "#" */
				MATRIX_KEY(6, 6, KEY_LEFTALT)
			>;
		};

		/*
		 * Jog dial rotation (S2820): JOG_INT = GPIO_00, JOG_DIR = GPIO_01, a quadrature
		 * pair resting high. Verified with gpioget: up = DIR falls first, down = INT
		 * falls first, so DIR's level at INT's falling edge gives the direction
		 * (drivers/input/misc/jog-dial.c). GPIO_00's interrupt: SIC2 0 as on the LPC32xx,
		 * verified on the device. The press is in the key matrix (KEY_ENTER above).
		 */
		jog-dial {
			compatible = "sonyericsson,jog-dial";
			interrupt-parent = <&sic2>;
			interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
			dir-gpios = <&gpio 3 1 GPIO_ACTIVE_HIGH>;
			linux,codes = <KEY_UP KEY_DOWN>;
		};

		/*
		 * PWM2 = BACKLIGHT_LEVEL, LPC32xx layout (drivers/pwm/pwm-lpc32xx.c), verified:
		 * Symbian left 0x80000145 (enabled, reload 1, duty reg 0x45 = low 69/256) and
		 * PWMCLK_CTRL 0x104 (PWM2 clock on, 32 kHz source, divider 1). The driver does
		 * not touch PWMCLK_CTRL. Higher duty = brighter; disabled = dark.
		 */
		pwm2: pwm@4005c004 {
			compatible = "nxp,lpc3220-pwm";
			reg = <0x4005c004 0x4>;
			clocks = <&xtal_32k>;
			#pwm-cells = <3>;
		};

		/*
		 * drivers/watchdog/pnx4008_wdt.c: provides the restart handler (reboot) and
		 * /dev/watchdog. It only starts counting when /dev/watchdog is opened; the
		 * payload stub stops it at handover. Its clock (TIMCLK_CTRL bit 0) was already
		 * on under Symbian; the driver assumes the fixed 13 MHz PERIPH_CLK.
		 */
		watchdog@4003c000 {
			compatible = "nxp,pnx4008-wdt";
			reg = <0x4003c000 0x1000>;
			clocks = <&periph_clk>;
		};

		/*
		 * Millisecond timer: 32-bit counter on the 32.768 kHz RTC clock, Symbian's tick,
		 * so already running at handover. Clocksource + clockevent (match 0).
		 * Line 27 verified on the device: clearing MSTIM_INT drops MIC RAW bit 27
		 * (0cc4a308 -> 04c4a308); Symbian had it enabled with POL=1, TYPE=0 (level high).
		 * Symbian ran it the same way: CTRL 5 (count + debug pause), MCTRL 1 (match 0
		 * interrupt, no reset).
		 * HSTIM (0x40038000) is the finer-grained alternative, but its clock is gated off
		 * under Symbian (TIMCLK_CTRL 0x400040bc bit 1).
		 */
		timer@40034000 {
			compatible = "nxp,pnx4008-mstim";
			reg = <0x40034000 0x1000>;
			interrupts = <27 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal_32k>;
		};
	};
};
