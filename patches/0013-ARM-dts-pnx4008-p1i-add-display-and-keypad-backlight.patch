From 18836fa44766faf207a3e0e587e6eb0432f7607b Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Tue, 13 Oct 2026 20:27:16 +0200
Subject: [PATCH 13/27] ARM: dts: pnx4008-p1i: add display and keypad backlight

PWM2 (BACKLIGHT_LEVEL) dims both lights and darkens them when disabled.
GPO_09/GPO_10 enable them: 00 off, 01/10 display + keypad, 11 display
only. Hold GPO_10 high with a hog and use GPO_09 (active low) as the
keypad LED; using GPO_10 as the pwm-backlight enable flashes the keypad
during power on/off, since pwm-backlight toggles it while the PWM runs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/pnx4008-p1i.dts | 52 +++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/arch/arm/boot/dts/pnx4008-p1i.dts b/arch/arm/boot/dts/pnx4008-p1i.dts
index 9d1455a30..6484ba068 100755
--- a/arch/arm/boot/dts/pnx4008-p1i.dts
+++ b/arch/arm/boot/dts/pnx4008-p1i.dts
@@ -23,6 +23,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/leds/common.h>
 
@@ -99,6 +100,36 @@ xtal_32k: xtal-32k {
 		};
 	};
 
+	/*
+	 * Display and keypad backlights (sheet BCT1DE). BACKLIGHT_LEVEL (PWM_OUT2) dims both;
+	 * with the PWM disabled its pin is low and both are dark. GPO_09 NUM_BACKLIGHT_EN and
+	 * GPO_10 QWERTY_BACKLIGHT_EN, verified on the device:
+	 *   9/10 = 0/0 all off, 1/0 or 0/1 display + keypad, 1/1 display only.
+	 * So GPO_10 is held high (hog in the gpio node) and GPO_09 (active low) is the keypad
+	 * LED; display on/off is the PWM alone, which darkens everything when disabled,
+	 * whatever GPO_09 is. GPO_10 is deliberately not the backlight's enable-gpios:
+	 * pwm-backlight toggles it while the PWM still runs, and the transient 1/0 state
+	 * flashes the keypad. Keypad brightness follows the display's.
+	 */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm2 0 7812500 0>;	/* 32768 Hz / 256 = 128 Hz, as Symbian */
+		/* Below ~15% duty the boost converter gives no visible light. */
+		brightness-levels = <0 40 64 96 128 160 192 224 255>;
+		default-brightness-level = <6>;	/* 75%, near Symbian's 73% */
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-keypad {
+			function = LED_FUNCTION_KBD_BACKLIGHT;
+			color = <LED_COLOR_ID_WHITE>;
+			gpios = <&gpio 5 9 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+
 	soc {
 		compatible = "simple-bus";
 		#address-cells = <1>;
@@ -259,6 +290,27 @@ gpio: gpio@40028000 {
 			reg = <0x40028000 0x1000>;
 			gpio-controller;
 			#gpio-cells = <3>;
+
+			/* Backlight enable, see the backlight node. */
+			qwerty-backlight-en-hog {
+				gpio-hog;
+				gpios = <5 10 GPIO_ACTIVE_HIGH>;
+				output-high;
+				line-name = "QWERTY_BACKLIGHT_EN";
+			};
+		};
+
+		/*
+		 * PWM2 = BACKLIGHT_LEVEL, LPC32xx layout (drivers/pwm/pwm-lpc32xx.c), verified:
+		 * Symbian left 0x80000145 (enabled, reload 1, duty reg 0x45 = low 69/256) and
+		 * PWMCLK_CTRL 0x104 (PWM2 clock on, 32 kHz source, divider 1). The driver does
+		 * not touch PWMCLK_CTRL. Higher duty = brighter; disabled = dark.
+		 */
+		pwm2: pwm@4005c004 {
+			compatible = "nxp,lpc3220-pwm";
+			reg = <0x4005c004 0x4>;
+			clocks = <&xtal_32k>;
+			#pwm-cells = <3>;
 		};
 
 		/*
