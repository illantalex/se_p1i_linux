From 5e1fac105b130711b3fab245030f7bb79998b691 Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Tue, 17 Nov 2026 21:21:48 +0100
Subject: [PATCH 63/72] backlight: pwm_bl: optional delay between PWM off and
 power supply off

On the Sony Ericsson P1i the backlight's boost converter output stays
charged after the PWM stops. Switching its enable (the backlight's
power supply) off at once lets that charge flash the keypad LEDs.

Add "post-pwm-off-delay-ms", the counterpart of post-pwm-on-delay-ms:
time to wait after disabling the PWM before the power supply goes off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../devicetree/bindings/leds/backlight/pwm-backlight.yaml  | 5 +++++
 drivers/video/backlight/pwm_bl.c                           | 7 +++++++
 include/linux/pwm_backlight.h                              | 1 +
 3 files changed, 13 insertions(+)

diff --git a/Documentation/devicetree/bindings/leds/backlight/pwm-backlight.yaml b/Documentation/devicetree/bindings/leds/backlight/pwm-backlight.yaml
index 78fbe20a1..e797a4c2f 100644
--- a/Documentation/devicetree/bindings/leds/backlight/pwm-backlight.yaml
+++ b/Documentation/devicetree/bindings/leds/backlight/pwm-backlight.yaml
@@ -39,6 +39,11 @@ properties:
       Delay in ms between disabling the backlight using GPIO and setting PWM
       value to 0.
 
+  post-pwm-off-delay-ms:
+    description:
+      Delay in ms between disabling the PWM and switching the power supply
+      off, e.g. for an output capacitor to drain.
+
   brightness-levels:
     description:
       Array of distinct brightness levels. Typically these are in the range
diff --git a/drivers/video/backlight/pwm_bl.c b/drivers/video/backlight/pwm_bl.c
index c0523a026..5a2341aa1 100644
--- a/drivers/video/backlight/pwm_bl.c
+++ b/drivers/video/backlight/pwm_bl.c
@@ -31,6 +31,7 @@ struct pwm_bl_data {
 	bool			legacy;
 	unsigned int		post_pwm_on_delay;
 	unsigned int		pwm_off_delay;
+	unsigned int		post_pwm_off_delay;
 	int			(*notify)(struct device *,
 					  int brightness);
 	void			(*notify_after)(struct device *,
@@ -82,6 +83,9 @@ static void pwm_backlight_power_off(struct pwm_bl_data *pb)
 	state.duty_cycle = 0;
 	pwm_apply_state(pb->pwm, &state);
 
+	if (pb->post_pwm_off_delay)
+		msleep(pb->post_pwm_off_delay);
+
 	regulator_disable(pb->power_supply);
 	pb->enabled = false;
 }
@@ -250,6 +254,8 @@ static int pwm_backlight_parse_dt(struct device *dev,
 	of_property_read_u32(node, "post-pwm-on-delay-ms",
 			     &data->post_pwm_on_delay);
 	of_property_read_u32(node, "pwm-off-delay-ms", &data->pwm_off_delay);
+	of_property_read_u32(node, "post-pwm-off-delay-ms",
+			     &data->post_pwm_off_delay);
 
 	/*
 	 * Determine the number of brightness levels, if this property is not
@@ -491,6 +497,7 @@ static int pwm_backlight_probe(struct platform_device *pdev)
 	pb->enabled = false;
 	pb->post_pwm_on_delay = data->post_pwm_on_delay;
 	pb->pwm_off_delay = data->pwm_off_delay;
+	pb->post_pwm_off_delay = data->post_pwm_off_delay;
 
 	pb->enable_gpio = devm_gpiod_get_optional(&pdev->dev, "enable",
 						  GPIOD_ASIS);
diff --git a/include/linux/pwm_backlight.h b/include/linux/pwm_backlight.h
index 06086cb93..59e928552 100644
--- a/include/linux/pwm_backlight.h
+++ b/include/linux/pwm_backlight.h
@@ -16,6 +16,7 @@ struct platform_pwm_backlight_data {
 	unsigned int *levels;
 	unsigned int post_pwm_on_delay;
 	unsigned int pwm_off_delay;
+	unsigned int post_pwm_off_delay;
 	int (*init)(struct device *dev);
 	int (*notify)(struct device *dev, int brightness);
 	void (*notify_after)(struct device *dev, int brightness);
-- 
