--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -496,6 +496,15 @@ config VCPU_STALL_DETECTOR
 
 	  If you do not intend to run this kernel as a guest, say N.
 
+config P1I_MODEM
+	tristate "Sony Ericsson P1i modem link (UART3)"
+	depends on OF && HAS_IOMEM
+	help
+	  The P1i's link to its DB2001 modem: UART3 as /dev/p1i-modem,
+	  interrupt driven, used exactly as the boot firmware (Symbian) set
+	  it up. Only the break is changed, on request (ioctl TIOCSBRK and
+	  TIOCCBRK).
+
 source "drivers/misc/c2port/Kconfig"
 source "drivers/misc/eeprom/Kconfig"
 source "drivers/misc/cb710/Kconfig"
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
