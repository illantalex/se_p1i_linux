From a86dc655bf2dc934e2defbc0f1746248040a823e Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Fri, 16 Oct 2026 22:43:13 +0200
Subject: [PATCH 25/37] ARM: dts: pnx4008-p1i: add the USB device controller

USB block at 0x31020000 (LPC32xx layout and interrupts): clock provider,
device controller, its I2C bus with the ISP1301-compatible ST STOTG04 at
0x2c. Found from Symbian's usbcc.dll and A1CommsHWController.dll.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/pnx4008-p1i.dts | 45 ++++++++++++++++++++++++++++++-
 1 file changed, 44 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/pnx4008-p1i.dts b/arch/arm/boot/dts/pnx4008-p1i.dts
index 211b125a9..57905ac7d 100755
--- a/arch/arm/boot/dts/pnx4008-p1i.dts
+++ b/arch/arm/boot/dts/pnx4008-p1i.dts
@@ -23,6 +23,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/clock/lpc32xx-clock.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
@@ -178,8 +179,9 @@ soc {
 		compatible = "simple-bus";
 		#address-cells = <1>;
 		#size-cells = <1>;
-		/* AHB peripherals (Memory Stick host) and APB peripherals */
+		/* AHB peripherals (Memory Stick host, USB) and APB peripherals */
 		ranges = <0x20000000 0x20000000 0x00100000>,
+			 <0x31020000 0x31020000 0x00001000>,
 			 <0x40000000 0x40000000 0x10000000>;
 
 		/* Main interrupt controller; register layout ER RSR SR APR ATR ITR (probe). */
@@ -337,6 +339,47 @@ stmpe_gpio: gpio {
 		 * card clock is set in MS_CTRL (0x40004080) as PLL / ceil(PLL / 20 MHz) with bits
 		 * 5-7 set. Card power is GPO_06 (MSMICRO_POW), card detect GPI_00 (low = card in).
 		 */
+		/*
+		 * USB device (Fast-Port connector): the LPC32xx USB block at 0x31020000, with the
+		 * same interrupts (SIC1 26/28/29/30/31). From Symbian's usbcc.dll and
+		 * A1CommsHWController.dll: the transceiver on the block's own I2C bus at 0x2c is
+		 * ISP1301-compatible (vendor ID 0x0483, ST), the USB PLL is in USB_CTRL
+		 * (0x40004064) and needs the main 13 MHz oscillator, which Symbian keeps stopped.
+		 * UART_CTRL bit 0 (UART5 on the USB pins) is 0 as Symbian leaves it.
+		 */
+		usbclk: clock-controller@31020f00 {
+			compatible = "nxp,pnx4008-usb-clk";
+			/* USB block clock control, USB_CTRL (USB PLL), OSC_CTRL (main oscillator) */
+			reg = <0x31020f00 0x100>, <0x40004064 0x4>, <0x4000404c 0x4>;
+			#clock-cells = <1>;
+		};
+
+		usbd: usbd@31020000 {
+			compatible = "nxp,lpc3220-udc";
+			reg = <0x31020000 0x300>;
+			interrupt-parent = <&sic1>;
+			interrupts = <29 IRQ_TYPE_LEVEL_HIGH>, <30 IRQ_TYPE_LEVEL_HIGH>,
+				     <28 IRQ_TYPE_LEVEL_HIGH>, <26 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&usbclk LPC32XX_USB_CLK_DEVICE>;
+			transceiver = <&usb_transceiver>;
+		};
+
+		i2cusb: i2c@31020300 {
+			compatible = "nxp,pnx-i2c";
+			reg = <0x31020300 0x100>;
+			interrupt-parent = <&sic1>;
+			interrupts = <31 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&usbclk LPC32XX_USB_CLK_I2C>;
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			usb_transceiver: usb-transceiver@2c {
+				compatible = "nxp,isp1301";
+				reg = <0x2c>;
+			};
+		};
+
 		memstick@20080000 {
 			compatible = "nxp,pnx4008-ms";
 			reg = <0x20080000 0x1000>, <0x40004080 0x4>;
-- 
