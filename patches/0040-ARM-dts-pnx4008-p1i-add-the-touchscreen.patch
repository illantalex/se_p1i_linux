From a64a994470fb77fca35e692d979587f0d4a3fbdd Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Mon, 19 Oct 2026 22:13:30 +0200
Subject: [PATCH 40/43] ARM: dts: pnx4008-p1i: add the touchscreen

The SoC's resistive touchscreen controller (LPC32xx layout) on SIC1 7,
clocked from the 32 kHz oscillator, with the panel range measured at the
display corners.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/pnx4008-p1i.dts | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm/boot/dts/pnx4008-p1i.dts b/arch/arm/boot/dts/pnx4008-p1i.dts
index 64ad6704f..5a70d0874 100755
--- a/arch/arm/boot/dts/pnx4008-p1i.dts
+++ b/arch/arm/boot/dts/pnx4008-p1i.dts
@@ -433,6 +433,27 @@ qwerty-backlight-en-hog {
 			};
 		};
 
+		/*
+		 * Resistive touchscreen controller (TOUCH1), LPC32xx layout. Symbian leaves it
+		 * running from the 32 kHz clock (ADCCLK_CTRL 0x400040B4 bit 0). Verified on the
+		 * device: touches fill the FIFO, SIC1 6 follows the pen (pen-detect), so the
+		 * FIFO interrupt is SIC1 7 as on LPC32xx.
+		 * X grows to the right, Y downwards (no swap). The range is the reported value
+		 * (driver output) measured at the corners of the 240x320 display: top left
+		 * 87/81, bottom right 931/970.
+		 */
+		touchscreen@40048000 {
+			compatible = "nxp,lpc3220-tsc";
+			reg = <0x40048000 0x1000>;
+			interrupt-parent = <&sic1>;
+			interrupts = <7 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&xtal_32k>;
+			touchscreen-min-x = <87>;
+			touchscreen-size-x = <932>;
+			touchscreen-min-y = <81>;
+			touchscreen-size-y = <971>;
+		};
+
 		/*
 		 * Key scanner, LPC32xx layout (drivers/input/keyboard/lpc32xx-keys.c). Wiring
 		 * (sheet BCT1DA p6): KEY_COL[0..5] / KEY_ROW[0..5] on the scanner pins, KEY_ROW[6]
