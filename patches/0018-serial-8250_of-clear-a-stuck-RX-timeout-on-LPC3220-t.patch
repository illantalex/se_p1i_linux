From 5a31edda78d23f5aadab4888b6903addfc3e315f Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Thu, 15 Oct 2026 22:30:21 +0200
Subject: [PATCH 18/37] serial: 8250_of: clear a stuck RX timeout on
 LPC3220-type UARTs

The PNX4008 UART (same block as the LPC3220) can be left by the boot
firmware asserting a character timeout (IIR 0xcc) with an empty receive
FIFO (LSR 0x60). The generic handler only reads RBR when LSR shows data,
so the interrupt never clears: on the Sony Ericsson P1i, opening the
console at boot took 16.9 million interrupts and stalled until a
character arrived on the line.

Do a dummy read of RBR in that case, as 8250_dw does for DesignWare
UARTs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/tty/serial/8250/8250_of.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/tty/serial/8250/8250_of.c b/drivers/tty/serial/8250/8250_of.c
index 1b461fba1..b8ff360cb 100644
--- a/drivers/tty/serial/8250/8250_of.c
+++ b/drivers/tty/serial/8250/8250_of.c
@@ -25,6 +25,28 @@ struct of_serial_info {
 	int line;
 };
 
+/*
+ * The LPC3220/PNX4008 UART can be left asserting a character timeout (IIR 0xcc) with an
+ * empty receive FIFO, e.g. by the boot firmware. The generic handler only reads RBR when
+ * LSR shows data, so the interrupt fires forever; a dummy read clears it (the same
+ * workaround as for DesignWare UARTs).
+ */
+static int lpc3220_handle_irq(struct uart_port *port)
+{
+	struct uart_8250_port *up = up_to_u8250p(port);
+	unsigned int iir = serial_port_in(port, UART_IIR);
+	unsigned long flags;
+
+	if ((iir & 0x3f) == UART_IIR_RX_TIMEOUT) {
+		spin_lock_irqsave(&port->lock, flags);
+		if (!(serial_lsr_in(up) & (UART_LSR_DR | UART_LSR_BI)))
+			serial_port_in(port, UART_RX);
+		spin_unlock_irqrestore(&port->lock, flags);
+	}
+
+	return serial8250_handle_irq(port, iir);
+}
+
 /*
  * Fill a struct uart_port for a given device node
  */
@@ -173,6 +195,9 @@ static int of_platform_serial_setup(struct platform_device *ofdev,
 	case PORT_RT2880:
 		port->iotype = UPIO_AU;
 		break;
+	case PORT_LPC3220:
+		port->handle_irq = lpc3220_handle_irq;
+		break;
 	}
 
 	if (IS_ENABLED(CONFIG_SERIAL_8250_FSL) &&
-- 
