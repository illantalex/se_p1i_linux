From 0bcac2d45300f59fd02cc07e75088fdcb2d37f11 Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Tue, 13 Oct 2026 00:18:08 +0200
Subject: [PATCH 05/21] clocksource: pnx4008-mstim: disarm the match after a
 one-shot event

In one-shot mode the match 0 interrupt stayed enabled after it fired,
so the same match would fire again when the 32-bit counter wraps
(about 36 hours at 32.768 kHz). Clear MCTRL in the handler for
one-shot events; set_next_event() arms it again.

Needed for NO_HZ_IDLE / HIGH_RES_TIMERS, which run the clockevent in
one-shot mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/clocksource/timer-pnx4008-mstim.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/clocksource/timer-pnx4008-mstim.c b/drivers/clocksource/timer-pnx4008-mstim.c
index 00b978dbd..7bcb678c2 100644
--- a/drivers/clocksource/timer-pnx4008-mstim.c
+++ b/drivers/clocksource/timer-pnx4008-mstim.c
@@ -109,6 +109,9 @@ static irqreturn_t mstim_interrupt(int irq, void *dev_id)
 		if ((s32)(readl(t->base + MSTIM_COUNTER) - match) >= 0)
 			match = readl(t->base + MSTIM_COUNTER) + t->period;
 		writel(match, t->base + MSTIM_MATCH0);
+	} else {
+		/* One-shot: disarm, or the same match fires again when the counter wraps. */
+		writel(0, t->base + MSTIM_MCTRL);
 	}
 
 	t->ced.event_handler(&t->ced);
