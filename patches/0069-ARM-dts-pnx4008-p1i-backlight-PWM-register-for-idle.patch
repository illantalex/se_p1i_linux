From 324a95b5d6f02fa663c665728f0d50bce7d606e2 Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Wed, 18 Nov 2026 20:51:04 +0100
Subject: [PATCH 69/72] ARM: dts: pnx4008-p1i: backlight PWM register for idle

The idle code follows the display: map the backlight PWM's control
register (enable bit = display on) in the idle node.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/pnx4008-p1i.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/pnx4008-p1i.dts b/arch/arm/boot/dts/pnx4008-p1i.dts
index be90e943d..016570e08 100755
--- a/arch/arm/boot/dts/pnx4008-p1i.dts
+++ b/arch/arm/boot/dts/pnx4008-p1i.dts
@@ -422,7 +422,8 @@ idle@40004044 {
 			reg = <0x40004044 0x4>, <0x40004058 0x4>, <0x31080000 0x30>,
 			      <0x40004020 0x20>, <0x40008000 0x10>, <0x40034000 0x20>,
 			      <0x400e8060 0x8>, <0x40004008 0xc>,
-			      <0x400bc000 0x60>, <0x400b8000 0x2000>;	/* DUM main, channels */
+			      <0x400bc000 0x60>, <0x400b8000 0x2000>,	/* DUM main, channels */
+			      <0x4005c004 0x4>;		/* backlight PWM: display on/off */
 		};
 
 		usbd: usbd@31020000 {
-- 
2.53.0

