From fb14c3166718903a74ba24bbb28d71b22275418b Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Tue, 20 Oct 2026 21:48:44 +0200
Subject: [PATCH 44/49] media: si470x: wait for the power up and keep the
 self-set registers

si470x_start() wrote the configuration right after setting ENABLE, but the
chip needs about 110 ms to power up (the I2C probe already waits for it).
After that, read back TEST1, TEST2 and BOOTCONFIG, which the chip sets
itself at power up: the I2C variant writes registers 0x02-0x09 on every
write, so cached values from before the power up overwrite them, and the
chip then does not tune (seen on the Sony Ericsson P1i after a reset).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/radio/si470x/radio-si470x-common.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/media/radio/si470x/radio-si470x-common.c b/drivers/media/radio/si470x/radio-si470x-common.c
index dc0c1d8d2..431a41386 100644
--- a/drivers/media/radio/si470x/radio-si470x-common.c
+++ b/drivers/media/radio/si470x/radio-si470x-common.c
@@ -99,6 +99,7 @@
 
 
 /* kernel includes */
+#include <linux/delay.h>
 #include "radio-si470x.h"
 
 /**************************************************************************
@@ -366,7 +367,7 @@ static int si470x_set_seek(struct si470x_device *radio,
  */
 int si470x_start(struct si470x_device *radio)
 {
-	int retval;
+	int retval, reg;
 
 	/* powercfg */
 	radio->registers[POWERCFG] =
@@ -374,6 +375,18 @@ int si470x_start(struct si470x_device *radio)
 	retval = radio->set_register(radio, POWERCFG);
 	if (retval < 0)
 		goto done;
+	/* power up : need 110ms, writes before that are lost after a powerdown */
+	msleep(110);
+	/*
+	 * The chip sets TEST1, TEST2 and BOOTCONFIG itself at power up; every
+	 * I2C write sends them too, so cache what it set (stale values left it
+	 * unable to tune after a reset).
+	 */
+	for (reg = TEST1; reg <= BOOTCONFIG; reg++) {
+		retval = radio->get_register(radio, reg);
+		if (retval < 0)
+			goto done;
+	}
 
 	/* sysconfig 1 */
 	radio->registers[SYSCONFIG1] |= SYSCONFIG1_RDSIEN | SYSCONFIG1_STCIEN |
-- 
