From a0aa5fc351f821c03553e91055cc7d4eafbfb3e0 Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Wed, 14 Oct 2026 20:47:33 +0200
Subject: [PATCH 14/27] Input: lpc32xx-keys - allow on ARMv5 multiplatform

The PNX4008 has the same key scanner at 0x40050000 (verified on the Sony
Ericsson P1i, interrupt SIC1 22), so let the driver build on
ARCH_MULTI_V5 without ARCH_LPC32XX.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/keyboard/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/input/keyboard/Kconfig b/drivers/input/keyboard/Kconfig
index 00292118b..b5fa75e34 100644
--- a/drivers/input/keyboard/Kconfig
+++ b/drivers/input/keyboard/Kconfig
@@ -390,7 +390,7 @@ config KEYBOARD_LOCOMO
 
 config KEYBOARD_LPC32XX
 	tristate "LPC32XX matrix key scanner support"
-	depends on ARCH_LPC32XX && OF
+	depends on (ARCH_LPC32XX || ARCH_MULTI_V5) && OF
 	select INPUT_MATRIXKMAP
 	help
 	  Say Y here if you want to use NXP LPC32XX SoC key scanner interface,
-- 
