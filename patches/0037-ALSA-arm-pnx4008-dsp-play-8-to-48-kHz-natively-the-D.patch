From f4447c6b9a98ec52a53c5acd2f0b0df6f0cddfda Mon Sep 17 00:00:00 2001
From: Illya Antonyuk <illantalex84@gmail.com>
Date: Mon, 19 Oct 2026 19:27:28 +0200
Subject: [PATCH 37/40] ALSA: arm: pnx4008-dsp: play 8 to 48 kHz natively, the
 DSP resamples

As Symbian does for other sample rates (traced with 48 and 22.05 kHz WAVs):
message 46 (area 0x1000, rate index 0-8 for 8000 ... 48000) and message 49
(resampling filter table 0x108 + 16 * index) switch the stream's input
rate; the halves stay 1008 bytes. prepare() sends them when the rate
changes, through the command/reply registers as dspextension does.

The 44.1 kHz family needs the filter coefficients Symbian loaded into SDRAM
with the codec module (0x81050000 and 0x8109e000, announced with message
12). Linux used that memory, so those rates turned into noise or silence
as soon as the DSP read the tables again. The device tree now reserves it
(memory-region of the DSP node) and probe loads DspCodecModule.bin and
DspSrcFilterCoefs.bin from the firmware again.

Probe also clears the halves: nobody refills them between the handover and
the first playback, and the DSP plays them in a loop -- a loud beep when
Symbian left audio in them.

Tested: 8, 11.025, 22.05, 32, 44.1 and 48 kHz clips of 12 s play in 12 s
through aplay; 8-48 kHz checked by ear with dsptool.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/boot/dts/pnx4008-p1i.dts |  14 +++
 sound/arm/pnx4008-dsp.c           | 177 ++++++++++++++++++++++++++++--
 2 files changed, 183 insertions(+), 8 deletions(-)

diff --git a/arch/arm/boot/dts/pnx4008-p1i.dts b/arch/arm/boot/dts/pnx4008-p1i.dts
index 34ff17e3b..64ad6704f 100755
--- a/arch/arm/boot/dts/pnx4008-p1i.dts
+++ b/arch/arm/boot/dts/pnx4008-p1i.dts
@@ -76,6 +76,18 @@ framebuffer_mem: framebuffer@81000000 {
 			no-map;
 		};
 
+		/*
+		 * Where Symbian leaves the audio DSP's modules (message 12 block at shared + 0x800:
+		 * DspCodecModule.bin at 0x81050000, DspSrcFilterCoefs.bin at 0x8109E000, up to
+		 * 0x810AA902). The DSP reads them by physical address whenever it is set up again,
+		 * e.g. the resampling filter tables on a sample rate change (message 49): if Linux
+		 * reuses this memory, 44.1 kHz-family rates turn into noise.
+		 */
+		dsp_symbian: dsp-symbian@81050000 {
+			reg = <0x81050000 0x5b000>;
+			no-map;
+		};
+
 		/*
 		 * Audio DSP modules (DspCodecModule.bin at +0, DspSrcFilterCoefs.bin at +0x4E000 as
 		 * in Symbian's layout), announced to the DSP with message 12; it reads them by
@@ -393,6 +405,8 @@ usb_transceiver: usb-transceiver@2c {
 		audio-dsp@400c0000 {
 			compatible = "nxp,pnx4008-dsp-pcm";
 			reg = <0x400c0000 0x40>, <0x400e8064 0x4>, <0x08001000 0x7e0>;
+			/* reloaded with DspCodecModule.bin and DspSrcFilterCoefs.bin */
+			memory-region = <&dsp_symbian>;
 		};
 
 		memstick@20080000 {
diff --git a/sound/arm/pnx4008-dsp.c b/sound/arm/pnx4008-dsp.c
index 4e840f457..936000c61 100644
--- a/sound/arm/pnx4008-dsp.c
+++ b/sound/arm/pnx4008-dsp.c
@@ -13,21 +13,32 @@
  * through Symbian's audio stream API and hands over with the stream running. This driver
  * adopts that stream, Symbian's "area 0":
  *
- *  - 44.1 kHz, 16-bit little-endian, stereo;
+ *  - 16-bit little-endian, stereo, 44.1 kHz as Symbian leaves it;
  *  - two 1008-byte halves (252 frames each) at shared buffer + 0x1000 (internal SRAM);
  *  - the DSP raises its semaphore 2 whenever it has taken a half; the ARM fills the next
  *    half and sets PSEM bit 2 (with the DSP clock request held, as Symbian's dspextension
- *    does) -- 175 times a second.
+ *    does) -- 175 times a second at 44.1 kHz.
+ *
+ * The DSP resamples to its output rate itself. As Symbian does for other sample rates,
+ * message 46 (area 0x1000, rate index) and message 49 (resampling filter table 0x108 +
+ * 16 * index) switch the stream's input rate; the halves stay 1008 bytes. The 44.1 kHz
+ * family needs the filter coefficients that Symbian loaded into SDRAM with the codec
+ * module (0x81050000, announced with message 12): they are reserved in the device tree
+ * and loaded again from the firmware files here, as Linux may have used that memory
+ * before.
  *
  * The semaphores are polled with an hrtimer while the stream plays (their interrupt is not
  * used yet). Without a stream from Symbian (PMASK bit 2 masked) playback stays silent.
  */
 
 #include <linux/delay.h>
+#include <linux/firmware.h>
 #include <linux/hrtimer.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
+#include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
 #include <linux/spinlock.h>
 #include <sound/core.h>
@@ -35,16 +46,35 @@
 #include <sound/pcm.h>
 
 /* Host port (APBP), 16-bit registers */
+#define APBP_PCFG	0x08
+#define APBP_PSTS	0x0c
 #define APBP_PSEM	0x10	/* ARM -> DSP semaphores */
 #define APBP_PMASK	0x14	/* DSP -> ARM semaphore interrupt mask */
 #define APBP_PCLEAR	0x18	/* acknowledge DSP -> ARM semaphores */
 #define APBP_SEM	0x1c	/* DSP -> ARM semaphores */
+#define APBP_CMD(n)	(0x20 + 8 * (n))
+#define APBP_REP(n)	(0x24 + 8 * (n))
+
+#define PCFG_REP0_IE	BIT(9)
+#define PSTS_REP0	BIT(10)
+#define PSTS_REP_ALL	(BIT(10) | BIT(11) | BIT(12))
+#define PSTS_CMD0	BIT(13)
+
+#define MSG_STREAM_RATE	46	/* area offset, rate index */
+#define MSG_SRC_TABLE	49	/* resampling filter table, 0 */
+#define STREAM_AREA	0x1000	/* shared buffer offset of area 0 */
+
+/* Symbian's DSP modules in SDRAM, offsets in the reserved area at 0x81050000 */
+#define FW_CODEC	"p1i-dsp/DspCodecModule.bin"
+#define FW_CODEC_OFF	0
+#define FW_SRC		"p1i-dsp/DspSrcFilterCoefs.bin"
+#define FW_SRC_OFF	0x4e000
 
 #define DSPCLKCTRL_REQ	BIT(9)	/* DSP clock request, held while setting PSEM */
 
 #define STREAM_SEM	BIT(2)	/* area 0 semaphore, both directions */
 #define HALF_BYTES	1008
-#define RATE		44100
+#define RATE		44100	/* as Symbian leaves the stream */
 #define POLL_NS		(1 * NSEC_PER_MSEC)
 /*
  * Up to 512 periods (2.9 s): reading from the Memory Stick (polled) or resampling can keep
@@ -53,6 +83,16 @@
  */
 #define PERIODS_MAX	512
 
+/* The DSP's rate indices */
+static const unsigned int pnx4008_dsp_rates[] = {
+	8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000,
+};
+
+static const struct snd_pcm_hw_constraint_list pnx4008_dsp_rate_list = {
+	.count = ARRAY_SIZE(pnx4008_dsp_rates),
+	.list = pnx4008_dsp_rates,
+};
+
 struct pnx4008_dsp {
 	struct device *dev;
 	void __iomem *apbp;
@@ -65,6 +105,8 @@ struct pnx4008_dsp {
 	unsigned int half;		/* half the DSP takes next */
 	unsigned int pos;		/* bytes into the ALSA buffer */
 	bool running;
+	struct mutex msg_lock;		/* command/reply registers */
+	unsigned int rate;		/* the stream's input rate on the DSP */
 };
 
 static u16 apbp_rd(struct pnx4008_dsp *dsp, unsigned int reg)
@@ -90,6 +132,116 @@ static void pnx4008_dsp_psem(struct pnx4008_dsp *dsp, u16 bits)
 	writel(clk, dsp->dspclkctrl);
 }
 
+/*
+ * Send a message the way Symbian's dspextension does and wait for its reply: parameters in
+ * CMD2/CMD1, then the type in CMD0; the DSP answers with the type in REP0 (status in bits
+ * 8-11).
+ */
+static int pnx4008_dsp_msg(struct pnx4008_dsp *dsp, u8 type, u16 p0, u16 p1)
+{
+	u16 sts, r0;
+	int i;
+
+	mutex_lock(&dsp->msg_lock);
+	/* A reply nobody waited for would be taken for ours */
+	if (apbp_rd(dsp, APBP_PSTS) & PSTS_REP_ALL) {
+		apbp_rd(dsp, APBP_REP(2));
+		apbp_rd(dsp, APBP_REP(1));
+		apbp_rd(dsp, APBP_REP(0));
+	}
+	for (i = 0; i < 100 && (apbp_rd(dsp, APBP_PSTS) & PSTS_CMD0); i++)
+		usleep_range(1000, 2000);
+
+	apbp_wr(dsp, APBP_PCFG, apbp_rd(dsp, APBP_PCFG) | PCFG_REP0_IE);
+	apbp_wr(dsp, APBP_CMD(2), p1);
+	apbp_wr(dsp, APBP_CMD(1), p0);
+	apbp_wr(dsp, APBP_CMD(0), type);
+
+	for (i = 0; i < 200 && !((sts = apbp_rd(dsp, APBP_PSTS)) & PSTS_REP0); i++)
+		usleep_range(1000, 2000);
+	if (!(sts & PSTS_REP0)) {
+		mutex_unlock(&dsp->msg_lock);
+		dev_err(dsp->dev, "message %u: no reply (PSTS %04x)\n", type, sts);
+		return -ETIMEDOUT;
+	}
+	apbp_rd(dsp, APBP_REP(2));
+	apbp_rd(dsp, APBP_REP(1));
+	r0 = apbp_rd(dsp, APBP_REP(0));
+	mutex_unlock(&dsp->msg_lock);
+	if ((r0 & 0xff) != type) {
+		dev_err(dsp->dev, "message %u: reply %04x\n", type, r0);
+		return -EIO;
+	}
+	return 0;
+}
+
+/* Switch the stream's input rate; the DSP resamples to its output rate itself. */
+static int pnx4008_dsp_set_rate(struct pnx4008_dsp *dsp, unsigned int rate)
+{
+	unsigned int i;
+	int ret;
+
+	if (rate == dsp->rate)
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(pnx4008_dsp_rates); i++)
+		if (pnx4008_dsp_rates[i] == rate)
+			break;
+	if (i == ARRAY_SIZE(pnx4008_dsp_rates))
+		return -EINVAL;
+
+	ret = pnx4008_dsp_msg(dsp, MSG_STREAM_RATE, STREAM_AREA, i);
+	if (!ret)
+		ret = pnx4008_dsp_msg(dsp, MSG_SRC_TABLE, 0x108 + 16 * i, 0);
+	if (ret)
+		return ret;
+	dev_dbg(dsp->dev, "stream rate %u Hz\n", rate);
+	dsp->rate = rate;
+	return 0;
+}
+
+/*
+ * Put Symbian's codec module and resampling filter coefficients back where the DSP reads
+ * them (the reserved area at 0x81050000): Linux may have used that memory before the
+ * reservation was in its device tree (a kexec from an older kernel). Without the files, the
+ * copy Symbian loaded is used as it is.
+ */
+static void pnx4008_dsp_load_modules(struct pnx4008_dsp *dsp)
+{
+	static const struct { const char *name; size_t off; } files[] = {
+		{ FW_CODEC, FW_CODEC_OFF },
+		{ FW_SRC, FW_SRC_OFF },
+	};
+	struct device_node *np;
+	struct reserved_mem *rmem;
+	const struct firmware *fw;
+	void *mem;
+	unsigned int i;
+
+	np = of_parse_phandle(dsp->dev->of_node, "memory-region", 0);
+	rmem = np ? of_reserved_mem_lookup(np) : NULL;
+	of_node_put(np);
+	if (!rmem) {
+		dev_warn(dsp->dev, "no memory-region for the DSP modules\n");
+		return;
+	}
+	mem = devm_memremap(dsp->dev, rmem->base, rmem->size, MEMREMAP_WC);
+	if (IS_ERR(mem)) {
+		dev_warn(dsp->dev, "cannot map the DSP modules: %ld\n", PTR_ERR(mem));
+		return;
+	}
+	for (i = 0; i < ARRAY_SIZE(files); i++) {
+		if (request_firmware(&fw, files[i].name, dsp->dev)) {
+			dev_warn(dsp->dev, "%s missing: keeping Symbian's copy\n", files[i].name);
+			continue;
+		}
+		if (files[i].off + fw->size <= rmem->size)
+			memcpy(mem + files[i].off, fw->data, fw->size);
+		else
+			dev_warn(dsp->dev, "%s too large\n", files[i].name);
+		release_firmware(fw);
+	}
+}
+
 /* Copy the next period of the ALSA buffer into the half the DSP takes next. */
 static void pnx4008_dsp_fill(struct pnx4008_dsp *dsp, struct snd_pcm_runtime *runtime)
 {
@@ -135,9 +287,9 @@ static const struct snd_pcm_hardware pnx4008_dsp_hw = {
 	.info = SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID |
 		SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_BLOCK_TRANSFER,
 	.formats = SNDRV_PCM_FMTBIT_S16_LE,
-	.rates = SNDRV_PCM_RATE_44100,
-	.rate_min = RATE,
-	.rate_max = RATE,
+	.rates = SNDRV_PCM_RATE_KNOT,
+	.rate_min = 8000,
+	.rate_max = 48000,
 	.channels_min = 2,
 	.channels_max = 2,
 	.buffer_bytes_max = PERIODS_MAX * HALF_BYTES,
@@ -153,7 +305,8 @@ static int pnx4008_dsp_open(struct snd_pcm_substream *substream)
 
 	substream->runtime->hw = pnx4008_dsp_hw;
 	dsp->substream = substream;
-	return 0;
+	return snd_pcm_hw_constraint_list(substream->runtime, 0, SNDRV_PCM_HW_PARAM_RATE,
+					  &pnx4008_dsp_rate_list);
 }
 
 static int pnx4008_dsp_close(struct snd_pcm_substream *substream)
@@ -170,7 +323,7 @@ static int pnx4008_dsp_prepare(struct snd_pcm_substream *substream)
 	struct pnx4008_dsp *dsp = snd_pcm_substream_chip(substream);
 
 	dsp->pos = 0;
-	return 0;
+	return pnx4008_dsp_set_rate(dsp, substream->runtime->rate);
 }
 
 static int pnx4008_dsp_trigger(struct snd_pcm_substream *substream, int cmd)
@@ -241,6 +394,8 @@ static int pnx4008_dsp_probe(struct platform_device *pdev)
 	dsp->dev = dev;
 	dsp->card = card;
 	spin_lock_init(&dsp->lock);
+	mutex_init(&dsp->msg_lock);
+	dsp->rate = RATE;
 	hrtimer_init(&dsp->timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
 	dsp->timer.function = pnx4008_dsp_poll;
 
@@ -260,6 +415,12 @@ static int pnx4008_dsp_probe(struct platform_device *pdev)
 	else
 		dev_info(dev, "adopting Symbian's audio stream (PMASK %04x, SEM %04x)\n",
 			 apbp_rd(dsp, APBP_PMASK), apbp_rd(dsp, APBP_SEM));
+	/*
+	 * Nobody refills the halves between the handover and the first playback: the DSP
+	 * keeps playing them in a loop, which is a loud beep if Symbian left audio in them.
+	 */
+	memset_io(dsp->area, 0, 2 * HALF_BYTES);
+	pnx4008_dsp_load_modules(dsp);
 
 	strscpy(card->driver, "PNX4008-DSP", sizeof(card->driver));
 	strscpy(card->shortname, "PNX4008 DSP", sizeof(card->shortname));
-- 
