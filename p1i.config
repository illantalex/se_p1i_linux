# Sony Ericsson P1i (PNX4008) bring-up config: everything off except what is listed here.
#   make O=../build ARCH=arm CROSS_COMPILE=arm-none-eabi- KCONFIG_ALLCONFIG=../p1i.config allnoconfig

# Platform: ARMv5 multiplatform, generic DT machine (no mach-lpc32xx)
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V5=y
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_CPU_ARM926T=y
CONFIG_AEABI=y
CONFIG_LPC32XX_IRQCHIP=y
CONFIG_CLKSRC_PNX4008_MSTIM=y
CONFIG_WATCHDOG=y
CONFIG_PNX4008_WATCHDOG=y

# Boot: zImage with the DTB appended; bootargs come from /chosen
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ARM_ATAG_DTB_COMPAT is not set
CONFIG_KERNEL_GZIP=y
CONFIG_BLK_DEV_INITRD=y

# Console on UART5 (16550-compatible, 0x40090000)
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y

# Low-level debug: decompressor and pre-console output straight to UART5.
# VIRT just has to be a free address in the fixed I/O area; the generic machine
# maps it with debug_ll_io_init().
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_8250=y
CONFIG_DEBUG_UART_PHYS=0x40090000
CONFIG_DEBUG_UART_VIRT=0xf4090000
CONFIG_DEBUG_UART_8250_SHIFT=2
CONFIG_DEBUG_UART_8250_WORD=y
# (DEBUG_UNCOMPRESS is unavailable on multiplatform: the decompressor stays silent)
CONFIG_EARLY_PRINTK=y

# Userspace: static BusyBox in a built-in initramfs (rootfs/ + initramfs.list, paths
# relative to the build directory, which sits next to them)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# glibc 2.43 (armel) calls the 32-bit time_t syscalls (clock_nanosleep, rt_sigtimedwait...)
# whenever the value fits, with no time64 fallback; allnoconfig drops them, which made
# sleep() return at once and BusyBox init spin at 100% CPU.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_INITRAMFS_SOURCE="../rootfs ../initramfs.list"
CONFIG_INITRAMFS_ROOT_UID=-1
CONFIG_INITRAMFS_ROOT_GID=-1
CONFIG_TMPFS=y
CONFIG_PRINTK_TIME=y

# Useful later, cheap now
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
